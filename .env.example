# Ambish Engineering - Email Notification Configuration
# To send direct emails to contact@ambishengineering.com via Microsoft 365 / Outlook SMTP:
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=contact@ambishengineering.com
SMTP_PASSWORD=your_microsoft_365_password_here

# Recipient email address (defaults to contact@ambishengineering.com)
CONTACT_EMAIL=contact@ambishengineering.com

# Optional alternative: Free Web3Forms access key (from web3forms.com)
# WEB3FORMS_KEY=your_web3forms_key_here
